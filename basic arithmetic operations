#include <stdio.h>

int main() {
    int num1, num2;
    char operation;

    printf("Enter the first number: ");
    scanf("%d", &num1);

    printf("Enter the operator (+, -, *, /): ");
    scanf(" %c", &operation);

    printf("Enter the second number: ");
    scanf("%d", &num2);

    switch (operation) {
        case '+':
            printf("%d + %d = %d", num1, num2, num1 + num2);
            break;
        case '-':
            printf("%d - %d = %d", num1, num2, num1 - num2);
            break;
        case '*':
            printf("%d * %d = %d", num1, num2, num1 * num2);
            break;
        case '/':
            if (num2 != 0)
                printf("%d / %d = %.2f", num1, num2, (float)num1 / num2);
            else
                printf("Error! Division by zero is not allowed");
            break;
        default:
            printf("Invalid operator. Please enter +, -, *, or /");
    }
    return 0;
}
