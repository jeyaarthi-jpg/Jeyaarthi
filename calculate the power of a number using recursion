#include <stdio.h>

int power(int base, int exponent);

int main() {
    int base, exponent;
    printf("Enter base: ");
    scanf("%d", &base);
    printf("Enter exponent: ");
    scanf("%d", &exponent);
    
    int result = power(base, exponent);
    printf("%d^%d = %d\n", base, exponent, result);
    
    return 0;
}
int power(int base, int exponent) {
    if (exponent == 0)
        return 1;
    else if (exponent > 0) {
        if (exponent % 2 == 0)
            return power(base * base, exponent / 2);
        else
            return ;
    }
    else
        return 1 / power(base, -exponent);
}
