
int countConsonants(char* str) {
    int count = 0;
    while (*str) {
        char ch = tolower(*str);
        if (ch >= 'a' && ch <= 'z' && ch != 'a' && ch != 'e' && ch != 'i' && ch != 'o' && ch != 'u') {
            count++;
        }
        str++;
    }
    return count;
}
int main() {
    char str[100];
    printf("Enter a string: ");
    scanf("%s", str);
    int consonants = countConsonants(str);
    printf("Number of consonants: %d\n", consonants);
    return 0;
}
