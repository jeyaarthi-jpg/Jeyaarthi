#include <stdio.h>

int find_max(int *a, int *b) {
    return (*a > *b) ? *a : *b;
}

int main() {
    int num1, num2;

    printf("Enter first number: ");
    scanf("%d", &num1);
    printf("Enter second number: ");
    scanf("%d", &num2);
    
  int max = find_max(&num1, &num2);

    printf("Maximum number: %d\n", max);

    return 0;
}
