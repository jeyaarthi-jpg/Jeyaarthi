#include <stdio.h>

int hcf(int num1, int num2) {
    if (num2 == 0) {
        return num1;
    } else {
        return hcf(num2, num1 % num2);
    }
}

int main() {
    int num1, num2;

    printf("Enter first number: ");
    scanf("%d", &num1);

    printf("Enter second number: ");
    scanf("%d", &num2);

    if (num1 <= 0 || num2 <= 0) {
        printf("Invalid input. Both numbers should be positive integers.\n");
    } else {
        int result = hcf(num1, num2);
        printf("HCF of %d and %d is: %d\n", num1, num2, result);
    }

    return 0;
}
