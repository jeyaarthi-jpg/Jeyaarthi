#include <stdio.h>

double calculate_commission(double sales_amount) {
    if (sales_amount < 0) {
        printf("Invalid sales amount. Please enter a non-negative value.\n");
        return 0;
    } 
    else if (sales_amount <= 100) {
        return sales_amount * 0.05;
    } 
    else if (sales_amount <= 1000) {
        return sales_amount * 0.08;
    } 
    else if (sales_amount <= 5000) {
        return sales_amount * 0.10;
    } 
    else {
        return sales_amount * 0.20;
    }
}

int main() {
    double sales_amount;

    printf("Enter sales amount: $");
    scanf("%lf", &sales_amount);

    double commission = calculate_commission(sales_amount);

    if (commission != 0) {
        printf("Commission earned: $%.2f\n", commission);
        printf("Commission rate: ");
        if (sales_amount <= 100) {
            printf("5%%\n");
        } 
        else if (sales_amount <= 1000) {
            printf("8%%\n");
        } 
        else if (sales_amount <= 5000) {
            printf("10%%\n");
        } 
        else {
            printf("20%%\n");
        }
    }

    return 0;
}
