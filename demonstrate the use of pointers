#include <stdio.h>

int main() {
     int var = 10;
    int *ptr;  
    ptr = &var;

    printf("Value of var: %d\n", var);
    printf("Address of var: %p\n", (void *)&var);
    printf("Value of ptr: %p\n", (void *)ptr);
    printf("Value at ptr: %d\n", *ptr);

    *ptr = 20;
    printf("Value of var after modification: %d\n", var);

    return 0;
}
