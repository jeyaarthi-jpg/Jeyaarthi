#include <stdio.h>

#define ROWS 2
#define COLS 2

void print_matrix(int *matrix) {
    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            printf("%d ", *(matrix + i * COLS + j));
        }
        printf("\n");
    }   }
void add_matrices(int *matrix1, int *matrix2, int *result) {
    for (int i = 0; i < ROWS; i++) {
        for (int j = 0; j < COLS; j++) {
            *(result + i * COLS + j) = *(matrix1 + i * COLS + j) + *(matrix2 + i * COLS + j);
        }    }   }

int main() {
    int matrix1[ROWS][COLS] = {{1, 2}, {3, 4}};
    int matrix2[ROWS][COLS] = {{5, 6}, {7, 8}};
    int result[ROWS][COLS];

    printf("Matrix 1:\n");
    print_matrix((int *)matrix1);

    printf("Matrix 2:\n");
    print_matrix((int *)matrix2);
 add_matrices((int *)matrix1, (int *)matrix2, (int *)result);

    printf("Sum of matrices:\n");
    print_matrix((int *)result);

    return 0;
}
