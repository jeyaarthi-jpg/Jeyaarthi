#include <stdio.h>

int main() {
    int n, i, j, k = 0;
    printf("Enter array size: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int temp[n];
    temp[0] = arr[0];
    for (i = 1; i < n; i++) {
        for (j = 0; j < k; j++) {
            if (temp[j] == arr[i]) {
                break;
            }        }
        if (j == k) {
            temp[k++] = arr[i];
        }   }
    printf("Array without duplicates: ");
    for (i = 0; i < k; i++) {
        printf("%d ", temp[i]);
    }
    printf("\n");
    return 0;
}
