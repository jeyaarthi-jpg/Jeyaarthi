#include <stdio.h>

void mergeArrays(int arr1[], int m, int arr2[], int n) {
    int merged[m + n];
    for (int i = 0; i < m; i++) {
        merged[i] = arr1[i];
    }
    for (int i = 0; i < n; i++) {
        merged[m + i] = arr2[i];
    }
    printf("Merged array: ");
    for (int i = 0; i < m + n; i++) {
        printf("%d ", merged[i]);
    }
    printf("\n");
}
int main() {
    int m, n;
    printf("Enter size of first array: ");
    scanf("%d", &m);
    int arr1[m];
    printf("Enter %d elements of first array:\n", m);
    for (int i = 0; i < m; i++) {
        scanf("%d", &arr1[i]);
    }
    printf("Enter size of second array: ");
    scanf("%d", &n);
    int arr2[n];
    printf("Enter %d elements of second array:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr2[i]);
    }
    mergeArrays(arr1, m, arr2, n);

    return 0;
}


