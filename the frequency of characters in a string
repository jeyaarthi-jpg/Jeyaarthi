#include <stdio.h>

void findFrequency(char str[]) {
    int frequency[256] = {0};
    for (int i = 0; str[i]; i++) {
        frequency[(int)str[i]]++;
    }
    for (int i = 0; i < 256; i++) {
        if (frequency[i] > 0) {
            printf("Character '%c' has frequency %d\n", (char)i, frequency[i]);
        }    }  }
int main() {
    char str[100];
    printf("Enter a string: ");
    scanf("%s", str);
    findFrequency(str);

    return 0;
}
