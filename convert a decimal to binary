#include <stdio.h>

void decimal_to_binary(int decimal) {
    int binary[32];
    int i = 0;

    while (decimal > 0) {
        binary[i++] = decimal % 2;
        decimal /= 2;
    }

    printf("Binary: ");
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }
    printf("\n");
}

int main() {
    int decimal;

    printf("Enter decimal number: ");
    scanf("%d", &decimal);

    decimal_to_binary(decimal);

    return 0;
}
