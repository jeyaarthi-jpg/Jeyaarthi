#include <stdio.h>

#define MAX_SHOWS 10
#define MAX_SEATS 100

typedef struct {
    char movie_name[100];
    char show_time[10];
    int seats[MAX_SEATS];
} Show;

Show shows[MAX_SHOWS];
int show_count = 0;

void add_show() {
    printf("Enter movie name: ");
    scanf("%s", shows[show_count].movie_name);
    printf("Enter show time: ");
    scanf("%s", shows[show_count].show_time);
    for (int i = 0; i < MAX_SEATS; i++) {
        shows[show_count].seats[i] = 0; 
    }
    show_count++;
    printf("Show added successfully!\n");
}

void display_shows() {
    printf("Available Shows:\n");
    for (int i = 0; i < show_count; i++) {
        printf("%d. %s - %s\n", i + 1, shows[i].movie_name, shows[i].show_time);
    }
}

void book_seat() {
    int show_number, seat_number;
    display_shows();
    printf("Enter show number: ");
    scanf("%d", &show_number);
    printf("Enter seat number (1-%d): ", MAX_SEATS);
    scanf("%d", &seat_number);

    if (show_number > 0 && show_number <= show_count && seat_number > 0 && seat_number <= MAX_SEATS) {
        if (shows[show_number - 1].seats[seat_number - 1] == 0) {
            shows[show_number - 1].seats[seat_number - 1] = 1; // Mark seat as booked
            printf("Seat booked successfully!\n");
        } else {
            printf("Seat already booked!\n");
        }
    } else {
        printf("Invalid show or seat number!\n");
    }
}

void cancel_booking() {
    int show_number, seat_number;
    display_shows();
    printf("Enter show number: ");
    scanf("%d", &show_number);
    printf("Enter seat number (1-%d): ", MAX_SEATS);
    scanf("%d", &seat_number);

    if (show_number > 0 && show_number <= show_count && seat_number > 0 && seat_number <= MAX_SEATS) {
        if (shows[show_number - 1].seats[seat_number - 1] == 1) {
            shows[show_number - 1].seats[seat_number - 1] = 0; // Mark seat as available
            printf("Booking cancelled successfully!\n");
        } else {
            printf("Seat is already available!\n");
        }
    } else {
        printf("Invalid show or seat number!\n");
    }
}

void display_available_seats() {
    int show_number;
    display_shows();
    printf("Enter show number: ");
    scanf("%d", &show_number);

    if (show_number > 0 && show_number <= show_count) {
        printf("Available Seats for %s - %s:\n", shows[show_number - 1].movie_name, shows[show_number - 1].show_time);
        for (int i = 0; i < MAX_SEATS; i++) {
            if (shows[show_number - 1].seats[i] == 0) {
                printf("%d ", i + 1);
            }
        }
        printf("\n");
    } else {
        printf("Invalid show number!\n");
    }
}

int main() {
    int choice;
    do {
        printf("Movie Ticket Booking System\n");
        printf("=================================\n");
        printf("1. Add Show\n");
        printf("2. Display Shows\n");
        printf("3. Book Seat\n");
        printf("4. Cancel Booking\n");
        printf("5. Display Available Seats\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                add_show();
                break;
            case 2:
                display_shows();
                break;
            case 3:
                book_seat();
                break;
            case 4:
                cancel_booking();
                break;
            case 5:
                display_available_seats();
                break;
            case 6:
                printf("Thank you for using the Movie Ticket Booking System!\n");
                break;
            default:
                printf("Invalid choice. Please try again.\n");
        }
    } while (choice != 6);

    return 0;
    
}
