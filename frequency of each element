#include <stdio.h>

void findFrequency(int arr[], int n) {
    int i, j, count;

    for (i = 0; i < n; i++) {
        count = 1;
        if (arr[i] != -1) {
            for (j = i + 1; j < n; j++) {
                if (arr[i] == arr[j]) {
                    count++;
                    arr[j] = -1; 
                }           }
            printf("Element %d: Frequency %d\n", arr[i], count);
        }  } }

int main() {
    int n;
    printf("Enter array size: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    findFrequency(arr, n);
    return 0;
}

