#include <stdio.h>
int sumOfEvenNumbers(int start, int end) {
    int sum = 0;
    for (int i = start; i <= end; i++) {
        if (i % 2 == 0) {
            sum += i;
        }
    }
    return sum;
}
int main() {
    int start = 1;
    int end = 100;
    int sum = sumOfEvenNumbers(start, end);
    printf("Sum of even numbers between %d and %d: %d\n", start, end, sum);
    return 0;
}
