#include <stdio.h>

int sum_of_digits(int n);

int main() {
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);
    
    int sum = sum_of_digits(num);
    printf("Sum of digits: %d\n", sum);
    
    return 0;
}
int sum_of_digits(int n) {
    if (n < 10)
        return n;
    
  else
        return (n % 10) + sum_of_digits(n / 10);
}
